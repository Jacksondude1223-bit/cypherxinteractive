{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cypherx-interactive",
  "compatibility_date": "2025-01-01",

  // Static-assets-only Worker: there is no `main` script, so every request is
  // served straight from Cloudflare's asset storage. Asset requests are not
  // billed as Worker invocations.
  "assets": {
    "directory": "./public",

    // Serve public/404.html (with a 404 status) for paths that match no asset.
    // Use "single-page-application" instead only if this ever becomes a SPA.
    "not_found_handling": "404-page"

    // html_handling defaults to "auto-trailing-slash", so /games and
    // /games.html both resolve to public/games.html.
  },

  "observability": {
    "enabled": true
  }
}
